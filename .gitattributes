# Penanganan Line Ending Otomatis
* text=auto

# Berkas Teks Spesifik
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.htaccess text eol=lf

# Berkas Biner (hindari konversi line ending agar berkas tidak rusak)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
